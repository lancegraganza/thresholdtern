{
  "name": "thresholdtern",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/copy-artifacts.mjs && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compact:compile": "node scripts/compile.mjs",
    "proof:up": "docker compose up -d",
    "proof:check": "node scripts/proof-check.mjs",
    "deploy:preprod": "node scripts/deploy.mjs",
    "verify": "npm run compact:compile && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.3.6", "react": "19.3.0", "react-dom": "19.3.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3", "tailwindcss": "4.3.3",
    "@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "typescript": "6.0.3", "vitest": "5.0.1"
  },
  "overrides": { "@midnight-ntwrk/compact-runtime": "0.16.0", "@midnight-ntwrk/onchain-runtime-v3": "3.0.0" }
}
